<FindBugsFilter>
    <Match>
        <Bug pattern="EQ_UNUSUAL"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- JMH generates these from the benchmarks -->
    <Match>
        <Package name="~.*\.jmh_generated"/>
    </Match>
</FindBugsFilter>
